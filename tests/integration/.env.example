# Copy to .env (git-ignored) and fill in. Variables already exported in your shell take precedence over this file.

# A space with ExO enabled (the exoM1 entitlement) and a published channel (default: "web").
CONTENTFUL_SPACE_ID=
CONTENTFUL_CDA_TOKEN=
CONTENTFUL_CPA_TOKEN=
# Personal access token able to create and delete ExO entities in the space.
CONTENTFUL_CMA_TOKEN=

# Optional
# CONTENTFUL_ENV_ID=master
# CONTENTFUL_DESTINATION_CHANNEL_ID=web
# prod (default) or staging; picks the delivery, preview and management hosts together.
# CONTENTFUL_API_TARGET=prod
