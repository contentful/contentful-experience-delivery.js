{
    "name": "@contentful/experience-delivery",
    "version": "1.0.0-dev.11",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/contentful/contentful-experience-delivery.js.git"
    },
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./experience": {
            "import": {
                "types": "./dist/esm/api/resources/experience/exports.d.mts",
                "default": "./dist/esm/api/resources/experience/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/experience/exports.d.ts",
                "default": "./dist/cjs/api/resources/experience/exports.js"
            },
            "default": "./dist/cjs/api/resources/experience/exports.js"
        },
        "./destination": {
            "import": {
                "types": "./dist/esm/api/resources/destination/exports.d.mts",
                "default": "./dist/esm/api/resources/destination/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/destination/exports.d.ts",
                "default": "./dist/cjs/api/resources/destination/exports.js"
            },
            "default": "./dist/cjs/api/resources/destination/exports.js"
        },
        "./release": {
            "import": {
                "types": "./dist/esm/api/resources/release/exports.d.mts",
                "default": "./dist/esm/api/resources/release/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/release/exports.d.ts",
                "default": "./dist/cjs/api/resources/release/exports.js"
            },
            "default": "./dist/cjs/api/resources/release/exports.js"
        },
        "./release/experience": {
            "import": {
                "types": "./dist/esm/api/resources/release/resources/experience/exports.d.mts",
                "default": "./dist/esm/api/resources/release/resources/experience/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/release/resources/experience/exports.d.ts",
                "default": "./dist/cjs/api/resources/release/resources/experience/exports.js"
            },
            "default": "./dist/cjs/api/resources/release/resources/experience/exports.js"
        },
        "./release/fragment": {
            "import": {
                "types": "./dist/esm/api/resources/release/resources/fragment/exports.d.mts",
                "default": "./dist/esm/api/resources/release/resources/fragment/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/release/resources/fragment/exports.d.ts",
                "default": "./dist/cjs/api/resources/release/resources/fragment/exports.js"
            },
            "default": "./dist/cjs/api/resources/release/resources/fragment/exports.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "reference.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format": "biome format --write --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "format:check": "biome format --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint": "biome lint --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint:fix": "biome lint --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check": "biome check --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check:fix": "biome check --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "build": "pnpm build:cjs && pnpm build:esm",
        "build:cjs": "tsc --project ./tsconfig.cjs.json",
        "build:esm": "tsc --project ./tsconfig.esm.json && node scripts/rename-to-esm-files.js dist/esm",
        "test": "vitest",
        "test:unit": "vitest --project unit",
        "test:integration": "vitest run --config vitest.integration.config.mts",
        "update-licenses": "node ./scripts/update-licenses.js"
    },
    "dependencies": {},
    "devDependencies": {
        "webpack": "^5.105.4",
        "ts-loader": "^9.5.4",
        "vitest": "^5.0.0",
        "@types/node": "^24.0.0",
        "typescript": "~5.9.3",
        "@biomejs/biome": "2.6.4",
        "license-checker-rseidelsohn": "^5.0.0"
    },
    "browser": {
        "fs": false,
        "os": false,
        "path": false,
        "stream": false,
        "crypto": false
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=22.0.0"
    },
    "sideEffects": false,
    "description": "TypeScript client for Contentful's Experience Delivery and Preview API",
    "license": "MIT"
}
