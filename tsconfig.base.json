{
    "compilerOptions": {
        "extendedDiagnostics": true,
        "strict": true,
        "target": "ES6",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "isolatedModules": true,
        "isolatedDeclarations": true,
        "types": ["node"]
    },
    "include": ["src"],
    "exclude": []
}
