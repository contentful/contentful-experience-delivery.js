{
    "name": "@contentful/experience-delivery",
    "version": "0.0.0-fern-placeholder",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/contentful/contentful-experience-delivery.js.git"
    },
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./serialization": {
            "import": {
                "types": "./dist/esm/serialization/index.d.mts",
                "default": "./dist/esm/serialization/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/serialization/index.d.ts",
                "default": "./dist/cjs/serialization/index.js"
            },
            "default": "./dist/cjs/serialization/index.js"
        },
        "./experience": {
            "import": {
                "types": "./dist/esm/api/resources/experience/exports.d.mts",
                "default": "./dist/esm/api/resources/experience/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/experience/exports.d.ts",
                "default": "./dist/cjs/api/resources/experience/exports.js"
            },
            "default": "./dist/cjs/api/resources/experience/exports.js"
        },
        "./template": {
            "import": {
                "types": "./dist/esm/api/resources/template/exports.d.mts",
                "default": "./dist/esm/api/resources/template/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/template/exports.d.ts",
                "default": "./dist/cjs/api/resources/template/exports.js"
            },
            "default": "./dist/cjs/api/resources/template/exports.js"
        },
        "./component": {
            "import": {
                "types": "./dist/esm/api/resources/component/exports.d.mts",
                "default": "./dist/esm/api/resources/component/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/component/exports.d.ts",
                "default": "./dist/cjs/api/resources/component/exports.js"
            },
            "default": "./dist/cjs/api/resources/component/exports.js"
        },
        "./fragment": {
            "import": {
                "types": "./dist/esm/api/resources/fragment/exports.d.mts",
                "default": "./dist/esm/api/resources/fragment/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/fragment/exports.d.ts",
                "default": "./dist/cjs/api/resources/fragment/exports.js"
            },
            "default": "./dist/cjs/api/resources/fragment/exports.js"
        },
        "./experienceFragment": {
            "import": {
                "types": "./dist/esm/api/resources/experienceFragment/exports.d.mts",
                "default": "./dist/esm/api/resources/experienceFragment/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/experienceFragment/exports.d.ts",
                "default": "./dist/cjs/api/resources/experienceFragment/exports.js"
            },
            "default": "./dist/cjs/api/resources/experienceFragment/exports.js"
        },
        "./release": {
            "import": {
                "types": "./dist/esm/api/resources/release/exports.d.mts",
                "default": "./dist/esm/api/resources/release/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/release/exports.d.ts",
                "default": "./dist/cjs/api/resources/release/exports.js"
            },
            "default": "./dist/cjs/api/resources/release/exports.js"
        },
        "./release/experience": {
            "import": {
                "types": "./dist/esm/api/resources/release/resources/experience/exports.d.mts",
                "default": "./dist/esm/api/resources/release/resources/experience/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/release/resources/experience/exports.d.ts",
                "default": "./dist/cjs/api/resources/release/resources/experience/exports.js"
            },
            "default": "./dist/cjs/api/resources/release/resources/experience/exports.js"
        },
        "./release/fragment": {
            "import": {
                "types": "./dist/esm/api/resources/release/resources/fragment/exports.d.mts",
                "default": "./dist/esm/api/resources/release/resources/fragment/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/release/resources/fragment/exports.d.ts",
                "default": "./dist/cjs/api/resources/release/resources/fragment/exports.js"
            },
            "default": "./dist/cjs/api/resources/release/resources/fragment/exports.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "reference.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format": "biome format --write --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "format:check": "biome format --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint": "biome lint --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint:fix": "biome lint --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check": "biome check --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check:fix": "biome check --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "build": "pnpm build:cjs && pnpm build:esm",
        "build:cjs": "tsc --project ./tsconfig.cjs.json",
        "build:esm": "tsc --project ./tsconfig.esm.json && node scripts/rename-to-esm-files.js dist/esm",
        "test": "vitest",
        "test:unit": "vitest --project unit",
        "update-licenses": "node ./scripts/update-licenses.js"
    },
    "dependencies": {},
    "devDependencies": {
        "webpack": "^5.105.4",
        "ts-loader": "^9.5.4",
        "vitest": "^4.1.1",
        "@types/node": "^20.0.0",
        "typescript": "~5.9.3",
        "@biomejs/biome": "2.4.10",
        "license-checker-rseidelsohn": "^4.4.2"
    },
    "browser": {
        "fs": false,
        "os": false,
        "path": false,
        "stream": false,
        "crypto": false
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": false,
    "description": "TypeScript client for Contentful's Experience Delivery and Preview API",
    "license": "MIT"
}
